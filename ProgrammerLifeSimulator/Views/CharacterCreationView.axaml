<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProgrammerLifeSimulator.ViewModels"
             xmlns:models="using:ProgrammerLifeSimulator.Models"
             x:Class="ProgrammerLifeSimulator.Views.CharacterCreationView"
             x:DataType="vm:CharacterCreationViewModel">
    
    <Grid RowDefinitions="Auto,*,Auto" Margin="40">
        <Grid.Background>
            <SolidColorBrush Color="#121212"/>
        </Grid.Background>

        <StackPanel Grid.Row="0" Margin="0,40,0,40" HorizontalAlignment="Center">
            <TextBlock Text="程序员生活模拟器" 
                       FontSize="40" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="CHARACTER SETUP" 
                       FontSize="12" 
                       Foreground="#555" 
                       HorizontalAlignment="Center" 
                       Margin="0,10,0,0"
                       LetterSpacing="4"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="30" MaxWidth="460" VerticalAlignment="Center">
            
            <StackPanel Spacing="10">
                <TextBlock Text="角色姓名" Foreground="#888" FontSize="14"/>
                <TextBox Text="{Binding PlayerName}" 
                         Watermark="请输入名称..." 
                         MaxLength="20" 
                         FontSize="16"
                         Height="45"
                         VerticalContentAlignment="Center"
                         Background="#1E1E1E"
                         Foreground="White"
                         BorderBrush="#333"
                         CornerRadius="2"/>
                <TextBlock Text="最多输入 20 个字符" 
                           Foreground="#555" 
                           FontSize="11" 
                           HorizontalAlignment="Right"/>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="初始特质" Foreground="#888" FontSize="14"/>
                <ComboBox ItemsSource="{Binding AvailableTraits}" 
                          SelectedItem="{Binding SelectedTrait}"
                          HorizontalAlignment="Stretch"
                          Height="45"
                          Background="#1E1E1E"
                          BorderBrush="#333">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Trait">
                            <TextBlock Text="{Binding Name}" Foreground="White"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <ContentControl Content="{Binding SelectedTrait}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="models:Trait">
                        <Border Background="#1A1A1A" 
                                Padding="20" 
                                CornerRadius="2" 
                                BorderBrush="#444" 
                                BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{Binding Name}" 
                                           FontSize="20" 
                                           FontWeight="Bold" 
                                           Foreground="#007ACC"/> <TextBlock Text="{Binding Description}" 
                                           TextWrapping="Wrap" 
                                           FontSize="14" 
                                           Foreground="#BBB" 
                                           LineHeight="22"/>
                                
                                <Rectangle Height="1" Fill="#222" Margin="0,5"/>
                                
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </StackPanel>

        <Button Grid.Row="2" 
                Command="{Binding StartGameCommand}"
                HorizontalAlignment="Center"
                Width="280"
                Height="55"
                Background="#007ACC"
                Foreground="White"
                BorderThickness="0"
                CornerRadius="2"
                Margin="0,40,0,20"
                HorizontalContentAlignment="Center" 
                VerticalContentAlignment="Center">
            <TextBlock Text="开始游玩" 
                       FontSize="18" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Button>
    </Grid>
</UserControl>